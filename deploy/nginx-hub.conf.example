# Reference vhost for a public anet-hub.
#
# This file is here because of a bug that cost an afternoon. The daemon's
# control plane caps request bodies, the hub caps them again, and nginx
# caps them a third time — and nginx is the one that decides, because it
# is first. Raising the two limits that live in Go changed nothing over
# the public path, since the vhost still said 1m.
#
# Three layers, and the deciding one lived in a file no repository
# contained. Now one of them does.
#
#     daemon control plane   internal/daemon/control_api.go  maxControlBody
#     hub                    internal/aghub/limits.go        Limits.sendBodyLimit (~128 MiB by default)
#     nginx                  this file                       client_max_body_size
#
# The number below must be the smallest of the three you actually want,
# and it is a memory decision as much as a size one: nginx buffers a body
# to disk before proxying, and the hub buffers it again to decode. On a
# small box, 512m of allowed body is a promise about disk you may not want
# to keep.
#
# Logs (A2A-DESIGN X1, §21 item 1) [redteam:F3]. The hub stores no record
# of who sent what to whom; nginx's default access log would. Every hub
# request line names agents (/agents/<aid>/..., /a2a/v1/agents/<aid>/card,
# /fed/v2/keys/<aid>, /x402/resource/<aid>/...) and comes from the client's
# address, so a kept log rebuilds the social graph — sender address ->
# recipient, with times and sizes — long after the envelope was acked and
# deleted. Both server blocks therefore keep no access log (access_log off
# also replaces the http-level one from nginx.conf) and an error log at crit
# only: an [error] line (hub down or restarting, body too large, timeout)
# carries "client: <address>" and "request: <request line>", a [crit] line
# is written before a request is read and carries at most an address.
# Retention: /var/log/nginx/hub.error.log is rotated by the host's
# logrotate rule for /var/log/nginx/*.log (Debian/Ubuntu stock: daily,
# rotate 14, compress), so nothing in it is older than 14 days. Do not add
# an access_log, or a log_format with $remote_addr or $request/$request_uri.

server {
    listen 80;
    listen [::]:80;
    server_name hub.example.org;
    access_log off;
    error_log  /var/log/nginx/hub.error.log crit;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hub.example.org;

    ssl_certificate     /etc/letsencrypt/live/hub.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hub.example.org/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # No access log, error log at crit only: see the top of this file.
    access_log off;
    error_log  /var/log/nginx/hub.error.log crit;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A delegation may carry an image or an archive inline. See the
        # note at the top before changing this: it is the limit that
        # actually applies.
        client_max_body_size 512m;

        # A capability call is work, not a page load. A caption model on
        # a cold start can take a minute, and a timeout here surfaces to
        # the caller as a failed delegation rather than a slow one.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
