# hub.agentnetwork.org.cn — ANetOS demo (/os). Insert INSIDE the 443 server block, BEFORE `location /`.
# Backend anet-osdemo.service binds 127.0.0.1:8068. Video generation is slow → long read timeout.
    location ^~ /os {
        proxy_pass http://127.0.0.1:8068;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 360s;
        proxy_buffering off;
        client_max_body_size 48m;
    }
