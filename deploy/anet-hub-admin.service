[Unit]
Description=AgentNetwork Hub operator plane (anet-hub-admin)
After=network-online.target anet-hub.service
Wants=network-online.target

[Service]
Type=simple
# Needs write access to the hub-owned hub.db (registry delete and restore) and its own admin/ tree.
# It no longer reaches any other host: the ssh ops plane, the monitor proxy and the harvest were
# removed (A2A-DESIGN §9), so root is not required for ssh any more. Running it as the hub's own
# account instead of root needs admin/ to be owned by that account; that is a deployment change and
# is not made by this file.
# It binds loopback only; nginx is the sole public face.
# ADMIN_TOKEN is REQUIRED (no default). The value below is a placeholder: anet-hub-admin refuses to
# start while ADMIN_TOKEN is CHANGE_ME or any other placeholder. Set a random secret before starting.
Environment=ADMIN_TOKEN=CHANGE_ME
ExecStart=/data/projs/anet-hub/bin/anet-hub-admin \
  --addr 127.0.0.1:8078 \
  --hub-data /data/projs/anet-hub/data \
  --data /data/projs/anet-hub/admin
WorkingDirectory=/data/projs/anet-hub
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
