        "body": {
          "reason": "home_unreachable",
          "error": "The recipient's hub did not answer; retry after the given seconds."
        }
      }
    },
    {
      "name": "with an identity header",
      "cite": "CORE-K15, DLV-W-17",
      "request": {
        "method": "POST",
        "path": "/relay/status",
        "headers": {
          "X-ANet-Wire": "3",
          "X-ANet-AID": "${hub}"
        },
        "json": {
          "items": [
            {
              "rid": "${rid_wait}",
              "handle": "${h_unknown}"
            }
          ]
        }
      },
      "response": {
        "status": 400,
        "body": {
          "reason": "identity_headers_not_allowed",
          "error": "Status checks are anonymous: send them without X-ANet identity headers."
        }
      }
    },
    {
      "name": "a body over 16 KiB",
      "cite": "core §2.12.2, DLV-W-16",
      "request": {
        "method": "POST",
        "path": "/relay/status",
        "headers": {
          "X-ANet-Wire": "3"
        },
        "text": "${big}"
      },
      "response": {
        "status": 413,
        "body": {
          "reason": "too_large",
          "error": "A status check body is at most 16 KiB."
        }
      }
    },
    {
      "name": "an item with an outcome",
      "cite": "CORE-E7, CORE-K13",
      "request": {
        "method": "POST",
        "path": "/relay/status",
        "headers": {
          "X-ANet-Wire": "3"
        },
        "json": {
          "items": [
            {
              "rid": "${rid_wait}",
              "handle": "${h_unknown}",
              "state": "done"
            }
          ]
        }
      },
      "response": {
        "status": 400,
        "body": {
          "reason": "bad_request",
          "error": "The request body has the member \"items[0].state\", which this route does not take; remove it and send again."
        }
      }
    },
    {
      "name": "no items",
      "cite": "DLV-W-16",
      "request": {
