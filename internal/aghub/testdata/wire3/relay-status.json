{
  "format": "wire3-fixture/1",
  "about": "POST /relay/status (core §2.12.2; p2p-receipts §2.4.3, §2.4.4, DLV-W-16, DLV-W-17, DLV-W-18, DLV-H-4, DLV-H-5): a sender's anonymous status check of 1 to 64 envelopes by the rid it was given and the handle of the confirmation, all queued at one hub (via_hub, absent for this one). Each item is queued while the mailbox holds the rid, else done with the stored dack, else unknown, in the order asked. Checked in this order: the client address's bucket (10 a second, 50 at once; 429 rate_limited) and no identity header (400 identity_headers_not_allowed), both before the body is read; the body at most 16 KiB (413 too_large); decoded strictly (400 bad_request); the items (400 bad_status_query). An envelope queued at a peer is asked of that peer, and a peer that does not answer is 502 home_unreachable with Retry-After, never unknown; a via_hub that is no peer is unknown.",
  "setup": "relay_status",
  "cases": [
    {
      "name": "queued",
      "cite": "§2.4.3",
      "request": {
        "method": "POST",
        "path": "/relay/status",
        "headers": {
          "X-ANet-Wire": "3"
        },
        "json": {
          "items": [
            {
              "rid": "${rid_wait}",
              "handle": "${h_unknown}"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "X-ANet-Wire": "3"
        },
        "body": {
          "items": [
            {
              "state": "queued"
            }
          ]
        }
      }
    },
    {
      "name": "done, with the dack",
      "cite": "§2.4.3, DLV-H-4",
      "request": {
        "method": "POST",
        "path": "/relay/status",
        "headers": {
          "X-ANet-Wire": "3"
        },
        "json": {
          "items": [
            {
              "rid": "${rid_done}",
              "handle": "${h_done}"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "state": "done",
              "dack": "${d_done}"
            }
          ]
        }
      }
    },
    {
      "name": "done is told by the handle",
      "cite": "§2.4.3",
      "request": {
        "method": "POST",
        "path": "/relay/status",
        "headers": {
          "X-ANet-Wire": "3"
        },
        "json": {
          "items": [
            {
              "rid": "${rid_unknown}",
              "handle": "${h_done}"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "state": "done",
              "dack": "${d_done}"
            }
          ]
        }
      }
    },
    {
      "name": "the right rid of a collected row with another handle",
      "cite": "T17",
      "request": {
        "method": "POST",
        "path": "/relay/status",
        "headers": {
          "X-ANet-Wire": "3"
        },
        "json": {
          "items": [
            {
              "rid": "${rid_done}",
              "handle": "${h_unknown}"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "state": "unknown"
            }
          ]
        }
      }
    },
    {
      "name": "three items, answered in order",
      "cite": "core §2.12.2",
      "request": {
        "method": "POST",
        "path": "/relay/status",
        "headers": {
          "X-ANet-Wire": "3"
        },
        "json": {
          "items": [
            {
              "rid": "${rid_unknown}",
              "handle": "${h_unknown}"
            },
            {
              "rid": "${rid_wait}",
              "handle": "${h_done}"
            },
            {
              "rid": "${rid_done}",
              "handle": "${h_done}"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "state": "unknown"
            },
            {
              "state": "queued"
            },
            {
              "state": "done",
              "dack": "${d_done}"
            }
          ]
        }
      }
    },
    {
      "name": "via this hub",
      "cite": "DLV-W-18",
      "request": {
        "method": "POST",
        "path": "/relay/status",
        "headers": {
          "X-ANet-Wire": "3"
        },
        "json": {
          "items": [
            {
              "rid": "${rid_wait}",
              "handle": "${h_unknown}",
              "via_hub": "${hub}"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "state": "queued"
            }
          ]
        }
      }
    },
    {
      "name": "via a hub that is not a peer",
      "cite": "DLV-W-18",
      "request": {
        "method": "POST",
        "path": "/relay/status",
        "headers": {
          "X-ANet-Wire": "3"
        },
        "json": {
          "items": [
            {
              "rid": "${rid_wait}",
              "handle": "${h_done}",
