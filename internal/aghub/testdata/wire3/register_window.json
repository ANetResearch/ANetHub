      "request": {"method": "POST", "path": "/register", "headers": {"X-ANet-Wire": "3"}, "sign": {"action": "register", "as": "stranger"},
        "json": {"aid": "${stranger}", "kel": "${stranger_kel}", "pow": {"seed": "${pow_seed}", "nonce": "${stranger_nonce}"}}},
      "response": {"status": 200, "body_has": {"aid": "${stranger}", "status": "registered", "trial": "pending"}}
