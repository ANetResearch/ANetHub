{
  "format": "wire3-fixture/1",
  "about": "POST /register on a closed hub with a sign-up window of one place (hub-payment-privacy PAY-A1 step 4c): check_only answers open while there is room; a newcomer with a good proof of work takes the place and registers on probation; the next newcomer finds the window full, 403 admission_required, proof of work or not.",
  "setup": "register_window",
