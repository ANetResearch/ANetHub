        "json": {"aid": "${stranger2}", "kel": "${stranger2_kel}", "check_only": true}},
      "response": {"status": 200, "body": {"status": "open"}}
    },
    {
      "name": "the window asks for a proof of work",
      "cite": "PAY-A1 step 4c",
      "request": {"method": "POST", "path": "/register", "headers": {"X-ANet-Wire": "3"}, "sign": {"action": "register", "as": "stranger"},
        "json": {"aid": "${stranger}", "kel": "${stranger_kel}"}},
      "response": {"status": 403, "body_has": {"reason": "pow_required", "challenge": {"bits": 22}}}
    },
    {
      "name": "a good proof of work takes the place",
