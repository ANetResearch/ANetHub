      "cite": "PAY-A1 step 4d",
      "request": {"method": "POST", "path": "/register", "headers": {"X-ANet-Wire": "3"}, "sign": {"action": "register", "as": "stranger2"},
        "json": {"aid": "${stranger2}", "kel": "${stranger2_kel}", "pow": {"seed": "${pow_seed}", "nonce": "${stranger2_nonce}"}}},
      "response": {"status": 403, "body_has": {"reason": "admission_required", "aid": "${stranger2}"}}
    }
  ]
