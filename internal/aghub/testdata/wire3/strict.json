    },
    {
      "name": "a member given twice",
      "cite": "CORE-E7",
      "request": {"method": "POST", "path": "/relay/poll", "headers": {"X-ANet-Wire": "3"}, "sign": {"action": "poll", "as": "alice"}, "json": {"limit": 1, "limit": 1000}},
      "response": {
        "status": 400,
        "headers": {"X-ANet-Wire": "3"},
        "body": {"reason": "bad_request", "error": "The request body has the member \"limit\" more than once; give each member once and send again."}
