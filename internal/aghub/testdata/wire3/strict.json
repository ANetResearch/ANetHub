      "cite": "CORE-E7",
      "request": {"method": "POST", "path": "/relay/poll", "headers": {"X-ANet-Wire": "3"}, "sign": {"action": "poll", "as": "alice"}, "json": {"after_id": -1}},
      "response": {"status": 400, "headers": {"X-ANet-Wire": "3"}, "body_has": {"reason": "bad_request"}}
