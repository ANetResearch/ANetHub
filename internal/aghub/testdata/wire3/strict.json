      "cite": "CORE-E7",
      "request": {"method": "POST", "path": "/relay/poll", "headers": {"X-ANet-Wire": "3"}, "sign": {"action": "poll", "as": "alice"}, "json": {"limit": 10, "after_id": 0}},
      "response": {"status": 200, "headers": {"X-ANet-Wire": "3"}, "body_has": {"messages": []}}
    },
    {
      "name": "an empty body asks for everything",
      "cite": "CORE-E7",
      "request": {"method": "POST", "path": "/relay/poll", "headers": {"X-ANet-Wire": "3"}, "sign": {"action": "poll", "as": "alice"}, "text": ""},
      "response": {"status": 200, "headers": {"X-ANet-Wire": "3"}, "body_has": {"messages": []}}
    },
    {
      "name": "an unknown member",
      "cite": "CORE-E7",
      "request": {"method": "POST", "path": "/relay/poll", "headers": {"X-ANet-Wire": "3"}, "sign": {"action": "poll", "as": "alice"}, "json": {"limit": 10, "zz_not_registered": 1}},
      "response": {
