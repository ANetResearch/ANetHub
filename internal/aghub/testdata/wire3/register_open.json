        "json": {"aid": "${stranger2}", "kel": "${stranger2_kel}", "pow": {"seed": "${pow_seed}", "nonce": "${stranger_nonce}"}}},
      "response": {"status": 403, "body_has": {"reason": "pow_required"}}
